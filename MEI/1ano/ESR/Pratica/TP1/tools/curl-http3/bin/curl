#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$BIN_DIR/.." && pwd)"

export LD_LIBRARY_PATH="$ROOT/lib64:$ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export OPENSSL_MODULES="$ROOT/lib64/ossl-modules"

exec "$BIN_DIR/curl.bin" "$@"
